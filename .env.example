# Copy to .env and fill in real values. .env is git-ignored; this template is not.
# Settings has no env prefix and is case-insensitive: KEY maps to the field of the
# same lowercase name (see src/foodiegram/settings.py).

# --- Instagram (only needed for the flagged instagrapi login; not on the server) ---
INSTAGRAM_USERNAME=your-instagram-handle
INSTAGRAM_PASSWORD=your-instagram-password
INSTAGRAM_COLLECTION_ID=00000000000000000
INSTAGRAM_SESSION_FILE=./session.json
# Optional: paste a browser sessionid to skip password login.
INSTAGRAM_SESSIONID=

# --- OpenAI (recipe extraction) ---
OPENAI_API_KEY=sk-proj-...

# --- Cloudinary (durable image hosting) ---
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=000000000000000
CLOUDINARY_API_SECRET=your-cloudinary-secret
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# --- Database (defaults to local SQLite; use the Neon POOLED URL in prod) ---
DATABASE_URL=sqlite:///data/dispensa.db

# --- HTTP Basic auth over the whole app (D13) ---
# Leave the username empty to disable auth (local dev). Set both in production.
BASIC_AUTH_USERNAME=
BASIC_AUTH_PASSWORD=
