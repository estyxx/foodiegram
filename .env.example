# Copy to .env and fill in real values. .env is git-ignored; this template is not.
# Settings has no env prefix and is case-insensitive: KEY maps to the field of the
# same lowercase name (see src/foodiegram/settings.py).
#
# The web server needs ONLY the "Runtime" block below. Everything under
# "Local pipeline" is optional and used solely by the local ingest/extract
# scripts; leave it unset on a deployed read-only server.

# --- Runtime (needed to serve the app) ---
# Defaults to local SQLite; use the Neon POOLED connection string in prod.
DATABASE_URL=sqlite:///data/dispensa.db
# HTTP Basic auth over the whole app (D13). Leave username empty to disable auth
# (local dev). Set both in production.
BASIC_AUTH_USERNAME=
BASIC_AUTH_PASSWORD=
# Comma-separated cross-origin allowlist. Empty = no CORS (SPA is same-origin).
CORS_ALLOW_ORIGINS=
# SPA directory, resolved against the process CWD. Defaults to ./frontend; only
# set this if you run the server from somewhere other than the repo root.
FRONTEND_DIR=frontend
# Commit SHA shown in the footer. Left empty, the app reads .git at runtime; set
# this in deploys where .git is not shipped so the footer shows the exact build.
GIT_SHA=

# --- Local pipeline: OpenAI (recipe extraction) ---
OPENAI_API_KEY=

# --- Local pipeline: Cloudinary (durable image hosting) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

# --- Local pipeline: Instagram (only for the flagged instagrapi login) ---
INSTAGRAM_USERNAME=
INSTAGRAM_PASSWORD=
INSTAGRAM_COLLECTION_ID=
INSTAGRAM_SESSION_FILE=./session.json
# Optional: paste a browser sessionid to skip password login.
INSTAGRAM_SESSIONID=
